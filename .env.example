# law.go.kr Open API OC (email id part before @) - REQUIRED for real data collection
# Either name works: LAW_API_OC (documented name) or LAW_OC (alias also accepted).
LAW_API_OC=

# Optional: enables AI-generated insights via OpenAI. Leave blank to disable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: set only if using an OpenAI-compatible proxy/gateway instead of api.openai.com.
OPENAI_BASE_URL=

# Backend / Frontend wiring
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Default collection window
DEFAULT_START_DATE=2016-01-01
DEFAULT_END_DATE=2026-12-31

# Forecast horizon (months)
FORECAST_HORIZON=6

# Test gating
RUN_INTEGRATION_TESTS=false

# Optional: enables Firestore persistence (analysis snapshots + chat history).
# Paste the ENTIRE contents of a Firebase service-account key JSON file
# (Firebase Console -> Project Settings -> Service accounts -> Generate new
# private key) as ONE line - never commit the key file itself to the repo.
# Leave blank to disable; the app works fully without it.
FIREBASE_CREDENTIALS_JSON=
